# Browser development runtime. The packaged Tauri app uses the OS app-data directory by default.
TAGIMAGE_SQLITE_PATH=.run/tagimage.sqlite

# Rust workers
IMGVIEWER_METADATA_AUTHORITATIVE=1
IMGVIEWER_THUMB_WORKERS=4
IMGVIEWER_THUMB_WAIT_MS=1200
IMGVIEWER_THUMB_POLL_MS=120
IMGVIEWER_THUMB_WORKER_EXPECTED=1
